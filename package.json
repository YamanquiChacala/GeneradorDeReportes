{
  "name": "montessori-school-report-generator",
  "description": "A simple GAS tool to help my school create student reports.",
  "version": "0.1.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@gas-plugin/unplugin": "^0.2.2",
    "@google/clasp": "^3.4.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/google-apps-script": "^2.0.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && jest",
    "test:coverage": "npm run typecheck && jest --coverage && node append-theme.cjs",
    "build": "npm run test && node build.mjs",
    "push": "npm run build && clasp push",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true
  }
}
